#!/usr/bin/python3 -I
"""Fixed entry executed inside the restricted runner mount/network namespace."""

import json
import os
import sys
from pathlib import Path
from uuid import UUID

if len(sys.argv) != 3:
    raise SystemExit("task and run IDs are required")
task_id, run_id = sys.argv[1:]
if any(str(UUID(value)) != value for value in (task_id, run_id)):
    raise SystemExit("canonical UUID required")
manifest = json.loads(Path("/run/qqbot/manifest.json").read_text())
general = manifest.get("schema_version") == 2
identity_key = "process_id" if general else "run_id"
if manifest["task_id"] != task_id or manifest[identity_key] != run_id:
    raise SystemExit("launch identity mismatch")
if not general and manifest["session_id"] != run_id:
    raise SystemExit("legacy session identity mismatch")
session_id = manifest["session_id"]
if str(UUID(session_id)) != session_id:
    raise SystemExit("canonical session UUID required")
if os.getuid() == 0:
    raise SystemExit("runner must use the dedicated unprivileged account")
status = Path("/proc/self/status").read_text()
if "NoNewPrivs:\t1" not in status:
    raise SystemExit("NoNewPrivileges is required")
for forbidden in ("/etc/qqbot", "/var/lib/qqbot", "/var/lib/qqbot-worker", "/run/qqbot/internal.sock"):
    if Path(forbidden).exists():
        raise SystemExit("host/private path is visible inside runner")
for home in ("/home", "/root"):
    try:
        if list(Path(home).iterdir()):
            raise SystemExit("personal home contents are visible inside runner")
    except (FileNotFoundError, PermissionError):
        pass
if any(
    line.split()[1] == "00000000"
    for line in Path("/proc/self/net/route").read_text().splitlines()[1:]
    if len(line.split()) > 1
):
    raise SystemExit("runner network namespace must have no default route")
os.umask(0o007)
workspace = Path("/workspace")
profile = workspace / "profile"
profile.mkdir(mode=0o770, exist_ok=True)
(workspace / "sessions").mkdir(mode=0o770, exist_ok=True)
config = {
    "providers": {
        "qqbot": {
            "baseUrl": manifest["proxy_url"] + "/v1",
            "api": "openai-completions",
            "apiKey": "binding-required" if general else manifest["model_token"],
            "models": [
                {
                    "id": manifest["model"],
                    "name": manifest["model"],
                    "reasoning": False,
                    "input": ["text"],
                    "contextWindow": manifest.get("model_context_window", 32768),
                    "maxTokens": manifest.get("output_tokens", 4096),
                    "cost": {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0},
                }
            ],
        }
    }
}
(profile / "models.json").write_text(json.dumps(config))
(profile / "settings.json").write_text(json.dumps({"cacheWarming": "off", "defaultThinkingLevel": "off",
    "compaction": {"enabled": True, "reserveTokens": manifest.get("model_context_window", 32768) - manifest.get("soft_input_tokens", 6000),
                   "keepRecentTokens": manifest.get("keep_recent_tokens", 2000)}}))
env = {
    "PATH": "/usr/bin:/bin",
    "LANG": "C.UTF-8",
    "HOME": str(profile),
    "PI_CODING_AGENT_DIR": str(profile),
    "PI_OFFLINE": "1",
    "PI_TELEMETRY": "0",
}
if general:
    env.update(QQBOT_GATEWAY_URL=manifest["proxy_url"], QQBOT_PROCESS_TOKEN=manifest["process_token"])
else:
    env.update(QQBOT_RESEARCH_URL=manifest["proxy_url"], QQBOT_TOOL_TOKEN=manifest["tool_token"])
argv = [
    "/usr/bin/node",
    "/opt/qqbot/node_modules/@earendil-works/pi-coding-agent/dist/cli.js",
    "--mode",
    "rpc",
    "--provider",
    "qqbot",
    "--model",
    manifest["model"],
    "--session",
    str(workspace / "sessions" / (session_id + ".jsonl")),
    "--no-extensions",
    "--no-builtin-tools",
    "--extension",
    "/opt/qqbot/pi_bridge.ts" if general else "/opt/qqbot/research_extension.ts",
    "--no-mcp",
    "--no-skills",
    "--no-prompt-templates",
    "--no-context-files",
    "--no-themes",
    "--no-approve",
    "--offline",
]
if general:
    if not isinstance(manifest.get("skill_version"), str) or not Path('/skills').is_dir():
        raise SystemExit('pinned skill resources are unavailable')
    argv += ['--skill', '/skills']
os.chdir(workspace)
os.execve(argv[0], argv, env)
