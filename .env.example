QQBOT_OFFICIAL_SECRET=
QQBOT_MODEL_KEY=
QQBOT_ADMIN_TOKEN=
# Generate once with: uv run python -c 'import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())'
# Keep this key across restarts and upgrades; existing QQ credentials require it.
QQBOT_CREDENTIAL_KEY=
# Ordinary OpenViking USER credential, never the global root key.
QQBOT_OPENVIKING_KEY=
# Optional host GitHub credential; never passed to workspace commands.
QQBOT_GITHUB_TOKEN=
