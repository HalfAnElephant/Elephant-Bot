          "title": "Cooldown Seconds",
          "type": "integer"
        },
        "min_human_messages": {
          "default": 3,
          "minimum": 0,
          "title": "Min Human Messages",
          "type": "integer"
        },
        "require_member_response": {
          "default": true,
          "title": "Require Member Response",
