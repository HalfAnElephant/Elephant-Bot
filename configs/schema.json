          "default": null,
          "title": "Model"
        },
        "api_key_env": {
          "default": "QQBOT_MODEL_KEY",
          "title": "Api Key Env",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 30,
          "maximum": 120,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "context_window": {
          "default": 32768,
          "maximum": 2000000,
          "minimum": 2048,
          "title": "Context Window",
          "type": "integer"
        }
      },
      "title": "ModelConfig",
      "type": "object"
