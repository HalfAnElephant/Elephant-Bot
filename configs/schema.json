        },
        "participation_budget_ratio": {
          "default": 0.2,
          "maximum": 1,
          "minimum": 0,
          "title": "Participation Budget Ratio",
          "type": "number"
        }
      },
      "title": "ParticipationSettings",
      "type": "object"
    },
    "PermissionPolicy": {
      "additionalProperties": false,
      "properties": {
        "preset": {
          "default": "allow_all",
          "enum": [
            "allow_all",
            "custom"
          ],
          "title": "Preset",
          "type": "string"
        },
        "default_effect": {
          "default": "allow",
          "enum": [
            "allow",
            "deny"
          ],
          "title": "Default Effect",
          "type": "string"
        },
        "rules": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PermissionRule"
          },
          "title": "Rules",
          "type": "array"
        }
      },
      "title": "PermissionPolicy",
      "type": "object"
    },
    "PermissionRule": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "priority": {
          "default": 0,
          "title": "Priority",
          "type": "integer"
        },
        "subject": {
          "$ref": "#/$defs/SubjectSelector"
        },
        "actions": {
          "default": [
            "*"
          ],
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Actions",
          "type": "array"
        },
        "resources": {
          "default": [
            "*"
          ],
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Resources",
          "type": "array"
        },
        "effect": {
          "enum": [
            "allow",
            "deny"
          ],
          "title": "Effect",
          "type": "string"
        }
      },
      "required": [
        "id",
        "effect"
      ],
      "title": "PermissionRule",
      "type": "object"
    },
