{
  "$defs": {
    "AdapterConfig": {
      "additionalProperties": false,
      "properties": {
        "instance_id": {
          "title": "Instance Id",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "kind": {
          "const": "official",
          "title": "Kind",
          "type": "string"
        },
        "transport": {
          "default": "webhook",
          "enum": [
            "webhook",
            "websocket"
          ],
          "title": "Transport",
          "type": "string"
        },
        "intents": {
          "default": 33554432,
          "exclusiveMinimum": 0,
          "title": "Intents",
          "type": "integer"
        },
        "bot_id": {
          "title": "Bot Id",
          "type": "string"
        },
        "secret_env": {
          "default": "",
          "title": "Secret Env",
          "type": "string"
        },
        "credential_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Ref"
        },
        "credential_store_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Credential Store Dir"
        },
        "app_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "App Id"
        },
        "allowed_groups": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Groups",
          "type": "array"
        },
        "allowed_users": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Users",
          "type": "array"
        },
        "admin_users": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Admin Users",
          "type": "array"
        },
        "full_mode_enabled": {
          "default": false,
          "title": "Full Mode Enabled",
          "type": "boolean"
        },
        "full_mode_verified": {
          "default": false,
          "title": "Full Mode Verified",
          "type": "boolean"
        },
        "proactive_verified": {
          "default": false,
          "title": "Proactive Verified",
          "type": "boolean"
        },
        "markdown_enabled": {
          "default": true,
          "title": "Markdown Enabled",
          "type": "boolean"
        },
        "rich_messages_enabled": {
          "default": true,
          "title": "Rich Messages Enabled",
          "type": "boolean"
        },
        "streaming_enabled": {
          "default": false,
          "title": "Streaming Enabled",
          "type": "boolean"
        },
        "typing_enabled": {
          "default": false,
          "title": "Typing Enabled",
          "type": "boolean"
        },
        "official_messages_per_minute": {
          "default": 20,
          "maximum": 20,
          "minimum": 1,
          "title": "Official Messages Per Minute",
          "type": "integer"
        },
        "official_bot_messages_per_minute": {
          "default": 30,
          "maximum": 600,
          "minimum": 1,
          "title": "Official Bot Messages Per Minute",
          "type": "integer"
        },
        "official_messages_per_day": {
          "default": 1000,
          "maximum": 1000,
          "minimum": 1,
          "title": "Official Messages Per Day",
          "type": "integer"
        },
        "c2c_reply_window_seconds": {
          "anyOf": [
            {
              "maximum": 3600,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "C2C Reply Window Seconds"
        },
        "c2c_max_replies": {
          "default": 4,
          "maximum": 4,
          "minimum": 1,
          "title": "C2C Max Replies",
          "type": "integer"
        },
        "group_reply_window_seconds": {
          "anyOf": [
            {
              "maximum": 300,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Reply Window Seconds"
        },
        "group_max_replies": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Group Max Replies"
        },
        "reply_window_seconds": {
          "default": 300,
          "maximum": 86400,
          "minimum": 1,
          "title": "Reply Window Seconds",
          "type": "integer"
        },
        "max_replies": {
          "default": 5,
          "maximum": 5,
          "minimum": 1,
          "title": "Max Replies",
          "type": "integer"
        },
        "signature_max_age_seconds": {
          "default": 300,
          "maximum": 86400,
          "minimum": 1,
          "title": "Signature Max Age Seconds",
          "type": "integer"
        },
        "api_base": {
          "default": "https://api.bot.qq.com",
          "title": "Api Base",
          "type": "string"
        },
        "token_url": {
          "default": "https://api.bot.qq.com/app/getAppAccessToken",
          "title": "Token Url",
          "type": "string"
        }
      },
      "required": [
        "instance_id",
        "kind",
        "bot_id"
      ],
      "title": "AdapterConfig",
      "type": "object"
    },
    "ContextConfig": {
      "additionalProperties": false,
      "properties": {
        "max_request_bytes": {
          "default": 16777216,
          "maximum": 16777216,
          "minimum": 4096,
          "title": "Max Request Bytes",
          "type": "integer"
        },
        "max_tokens": {
          "anyOf": [
            {
              "maximum": 2000000,
              "minimum": 256,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "pi soft compaction threshold; null reserves 10% of the model window or output headroom, whichever is larger",
          "title": "Max Tokens"
        },
        "keep_recent_tokens": {
          "anyOf": [
            {
              "maximum": 2000000,
              "minimum": 128,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "pi recent context retained during compaction; null uses 20% of the model window",
          "title": "Keep Recent Tokens"
        },
        "compaction_output_tokens": {
          "default": 4096,
          "maximum": 32768,
          "minimum": 128,
          "title": "Compaction Output Tokens",
          "type": "integer"
        },
        "recent_messages": {
          "default": 64,
          "maximum": 100,
          "minimum": 1,
          "title": "Recent Messages",
          "type": "integer"
        },
        "topic_idle_seconds": {
          "default": 1800,
          "maximum": 86400,
          "minimum": 60,
          "title": "Topic Idle Seconds",
          "type": "integer"
        },
        "version": {
          "default": "context-v2",
          "title": "Version",
          "type": "string"
        }
      },
      "title": "ContextConfig",
      "type": "object"
    },
    "ExecutionConfig": {
      "additionalProperties": false,
      "properties": {
        "leader_environment": {
          "default": "host",
          "enum": [
            "sandbox",
            "host"
          ],
          "title": "Leader Environment",
          "type": "string"
        },
        "worker_environment": {
          "default": "sandbox",
          "enum": [
            "sandbox",
            "host"
          ],
          "title": "Worker Environment",
          "type": "string"
        },
        "notify_before_tools": {
          "default": true,
          "title": "Notify Before Tools",
          "type": "boolean"
        },
        "max_active": {
          "default": 8,
          "deprecated": true,
          "description": "Legacy compatibility field; active Agent admission is unrestricted",
          "minimum": 0,
          "title": "Max Active",
          "type": "integer"
        },
        "sustained_limit": {
          "default": 2,
          "deprecated": true,
          "description": "Legacy compatibility field; background Agent admission is unrestricted",
          "minimum": 0,
          "title": "Sustained Limit",
          "type": "integer"
        },
        "foreground_wait_ms": {
          "default": 5000,
          "maximum": 60000,
          "minimum": 0,
          "title": "Foreground Wait Ms",
          "type": "integer"
        },
        "interactive_budget": {
          "$ref": "#/$defs/RunBudget",
          "default": {
            "model_calls": 30,
            "tool_calls": 80,
            "active_seconds": 600,
            "total_wall_seconds": 3600,
            "output_tokens_per_call": null,
            "completion_reserve": 1
          }
        },
        "budget": {
          "$ref": "#/$defs/RunBudget",
          "default": {
            "model_calls": 60,
            "tool_calls": 200,
            "active_seconds": 1800,
            "total_wall_seconds": 7200,
            "output_tokens_per_call": null,
            "completion_reserve": 1
          }
        },
        "warm_max": {
          "default": 4,
          "maximum": 32,
          "minimum": 0,
          "title": "Warm Max",
          "type": "integer"
        },
        "warm_idle_max": {
          "default": 2,
          "maximum": 32,
          "minimum": 0,
          "title": "Warm Idle Max",
          "type": "integer"
        },
        "warm_ttl_seconds": {
          "default": 300,
          "maximum": 3600,
          "minimum": 1,
          "title": "Warm Ttl Seconds",
          "type": "integer"
        }
      },
      "title": "ExecutionConfig",
      "type": "object"
    },
    "HermesConfig": {
      "additionalProperties": false,
      "properties": {
        "create_dir": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Create Dir"
        },
        "write_approval": {
          "const": false,
          "default": false,
          "title": "Write Approval",
          "type": "boolean"
        },
        "inline_shell": {
          "const": false,
          "default": false,
          "title": "Inline Shell",
          "type": "boolean"
        },
        "ledger": {
          "default": true,
          "title": "Ledger",
          "type": "boolean"
        },
        "ledger_max_bytes": {
          "default": 5242880,
          "minimum": 0,
          "title": "Ledger Max Bytes",
          "type": "integer"
        },
        "creation_nudge_interval": {
          "default": 10,
          "maximum": 1000,
          "minimum": 0,
          "title": "Creation Nudge Interval",
          "type": "integer"
        }
      },
      "title": "HermesConfig",
      "type": "object"
    },
    "MemoryBinding": {
      "additionalProperties": false,
      "description": "Resolved by host configuration, never a model-supplied credential selector.",
      "properties": {
        "owner_id": {
          "title": "Owner Id",
          "type": "string"
        },
        "workspace_id": {
          "default": "personal",
          "title": "Workspace Id",
          "type": "string"
        },
        "account_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Account Id",
          "type": "string"
        },
        "user_id": {
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "User Id",
          "type": "string"
        },
        "api_key_env": {
          "minLength": 1,
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Api Key Env",
          "type": "string"
        }
      },
      "required": [
        "owner_id",
        "account_id",
        "user_id",
        "api_key_env"
      ],
      "title": "MemoryBinding",
      "type": "object"
    },
    "MemoryConfig": {
      "additionalProperties": false,
      "properties": {
        "openviking": {
          "$ref": "#/$defs/OpenVikingConfig",
          "default": {
            "endpoint": null,
            "api_key_env": "QQBOT_OPENVIKING_KEY",
            "namespace": "elephant",
            "bindings": [],
            "expected_version": "v0.5.4.1",
            "private_enabled": true,
            "group_enabled": false,
            "timeout_seconds": 2.0,
            "operation_budget_seconds": 8.0,
            "max_query_chars": 4000,
            "recall_max_chars": 8000
          }
        }
      },
      "title": "MemoryConfig",
      "type": "object"
    },
    "ModelConfig": {
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "api_key_env": {
          "default": "QQBOT_MODEL_KEY",
          "title": "Api Key Env",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 30,
          "maximum": 120,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "context_window": {
          "default": 32768,
          "maximum": 2000000,
          "minimum": 2048,
          "title": "Context Window",
          "type": "integer"
        }
      },
      "title": "ModelConfig",
      "type": "object"
    },
    "OpenVikingConfig": {
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint"
        },
        "api_key_env": {
          "default": "QQBOT_OPENVIKING_KEY",
          "title": "Api Key Env",
          "type": "string"
        },
        "namespace": {
          "default": "elephant",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,47}$",
          "title": "Namespace",
          "type": "string"
        },
        "bindings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/MemoryBinding"
          },
          "title": "Bindings",
          "type": "array"
        },
        "expected_version": {
          "default": "v0.5.4.1",
          "title": "Expected Version",
          "type": "string"
        },
        "private_enabled": {
          "default": true,
          "title": "Private Enabled",
          "type": "boolean"
        },
        "group_enabled": {
          "default": false,
          "title": "Group Enabled",
          "type": "boolean"
        },
        "timeout_seconds": {
          "default": 2.0,
          "maximum": 30,
          "minimum": 0.1,
          "title": "Timeout Seconds",
          "type": "number"
        },
        "operation_budget_seconds": {
          "default": 8.0,
          "maximum": 60,
          "minimum": 0.1,
          "title": "Operation Budget Seconds",
          "type": "number"
        },
        "max_query_chars": {
          "default": 4000,
          "maximum": 8000,
          "minimum": 100,
          "title": "Max Query Chars",
          "type": "integer"
        },
        "recall_max_chars": {
          "default": 8000,
          "maximum": 32000,
          "minimum": 256,
          "title": "Recall Max Chars",
          "type": "integer"
        }
      },
      "title": "OpenVikingConfig",
      "type": "object"
    },
    "OrchestrationConfig": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "leader_workers",
          "default": "leader_workers",
          "title": "Mode",
          "type": "string"
        },
        "pending_inputs_per_owner": {
          "default": 64,
          "deprecated": true,
          "description": "Legacy compatibility field; pending inputs are unrestricted",
          "minimum": 0,
          "title": "Pending Inputs Per Owner",
          "type": "integer"
        },
        "pending_root_tasks_per_owner": {
          "default": 5,
          "deprecated": true,
          "description": "Legacy compatibility field; pending goals are unrestricted",
          "minimum": 0,
          "title": "Pending Root Tasks Per Owner",
          "type": "integer"
        },
        "child_parallelism": {
          "default": 2,
          "deprecated": true,
          "description": "Legacy compatibility field; child admission is unrestricted",
          "minimum": 0,
          "title": "Child Parallelism",
          "type": "integer"
        },
        "max_task_depth": {
          "default": 2,
          "deprecated": true,
          "description": "Legacy compatibility field; task tree depth is unrestricted",
          "minimum": 0,
          "title": "Max Task Depth",
          "type": "integer"
        },
        "max_nodes_per_root": {
          "default": 7,
          "deprecated": true,
          "description": "Legacy compatibility field; task node count is unrestricted",
          "minimum": 0,
          "title": "Max Nodes Per Root",
          "type": "integer"
        },
        "leader_inbox_batch_limit": {
          "default": 16,
          "maximum": 64,
          "minimum": 1,
          "title": "Leader Inbox Batch Limit",
          "type": "integer"
        },
        "leader_inbox_coalesce_seconds": {
          "default": 2,
          "maximum": 60,
          "minimum": 0,
          "title": "Leader Inbox Coalesce Seconds",
          "type": "number"
        },
        "model_request_limit": {
          "default": 8,
          "maximum": 32,
          "minimum": 1,
          "title": "Model Request Limit",
          "type": "integer"
        },
        "pi_executable": {
          "default": "node_modules/.bin/pi",
          "title": "Pi Executable",
          "type": "string"
        },
        "github_host": {
          "default": "github.com",
          "title": "Github Host",
          "type": "string"
        },
        "workspace_bindings": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Workspace Bindings",
          "type": "object"
        }
      },
      "title": "OrchestrationConfig",
      "type": "object"
    },
    "OwnerConfig": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "default": "personal-owner",
          "pattern": "^[a-zA-Z0-9_-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "qq_bindings": {
          "default": [],
          "items": {
            "$ref": "#/$defs/QQOwnerBinding"
          },
          "title": "Qq Bindings",
          "type": "array"
        },
        "preferences": {
          "default": "",
          "description": "Explicit personal preferences such as preferred name, language, and communication style.",
          "maxLength": 4000,
          "title": "Preferences",
          "type": "string"
        }
      },
      "title": "OwnerConfig",
      "type": "object"
    },
    "PermissionPolicy": {
      "additionalProperties": false,
      "properties": {
        "preset": {
          "default": "allow_all",
          "enum": [
            "allow_all",
            "custom"
          ],
          "title": "Preset",
          "type": "string"
        },
        "default_effect": {
          "default": "allow",
          "enum": [
            "allow",
            "deny"
          ],
          "title": "Default Effect",
          "type": "string"
        },
        "rules": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PermissionRule"
          },
          "title": "Rules",
          "type": "array"
        }
      },
      "title": "PermissionPolicy",
      "type": "object"
    },
    "PermissionRule": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "priority": {
          "default": 0,
          "title": "Priority",
          "type": "integer"
        },
        "subject": {
          "$ref": "#/$defs/SubjectSelector"
        },
        "actions": {
          "default": [
            "*"
          ],
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Actions",
          "type": "array"
        },
        "resources": {
          "default": [
            "*"
          ],
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Resources",
          "type": "array"
        },
        "effect": {
          "enum": [
            "allow",
            "deny"
          ],
          "title": "Effect",
          "type": "string"
        }
      },
      "required": [
        "id",
        "effect"
      ],
      "title": "PermissionRule",
      "type": "object"
    },
    "QQOwnerBinding": {
      "additionalProperties": false,
      "properties": {
        "app_id": {
          "minLength": 1,
          "title": "App Id",
          "type": "string"
        },
        "user_openid": {
          "minLength": 1,
          "title": "User Openid",
          "type": "string"
        },
        "verified_at": {
          "minLength": 1,
          "title": "Verified At",
          "type": "string"
        }
      },
      "required": [
        "app_id",
        "user_openid",
        "verified_at"
      ],
      "title": "QQOwnerBinding",
      "type": "object"
    },
    "RunBudget": {
      "additionalProperties": false,
      "properties": {
        "model_calls": {
          "default": 60,
          "maximum": 200,
          "minimum": 2,
          "title": "Model Calls",
          "type": "integer"
        },
        "tool_calls": {
          "default": 200,
          "maximum": 1000,
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "active_seconds": {
          "default": 1800,
          "maximum": 86400,
          "minimum": 1,
          "title": "Active Seconds",
          "type": "integer"
        },
        "total_wall_seconds": {
          "default": 7200,
          "maximum": 604800,
          "minimum": 1,
          "title": "Total Wall Seconds",
          "type": "integer"
        },
        "output_tokens_per_call": {
          "anyOf": [
            {
              "maximum": 32768,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional per-request output limit; null uses the provider default",
          "title": "Output Tokens Per Call"
        },
        "completion_reserve": {
          "default": 1,
          "minimum": 1,
          "title": "Completion Reserve",
          "type": "integer"
        }
      },
      "title": "RunBudget",
      "type": "object"
    },
    "SkillsConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "group_enabled": {
          "default": false,
          "title": "Group Enabled",
          "type": "boolean"
        },
        "provider": {
          "const": "hermes",
          "default": "hermes",
          "title": "Provider",
          "type": "string"
        },
        "owner_storage_root": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Storage Root"
        },
        "hermes": {
