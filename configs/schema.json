{
  "$defs": {
    "AdapterConfig": {
      "additionalProperties": false,
      "properties": {
        "instance_id": {
          "title": "Instance Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "onebot",
            "official"
          ],
          "title": "Kind",
          "type": "string"
        },
        "bot_id": {
          "title": "Bot Id",
          "type": "string"
        },
        "secret_env": {
          "title": "Secret Env",
          "type": "string"
        },
        "app_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "App Id"
        },
        "websocket_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Websocket Url"
        },
        "allowed_groups": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Groups",
          "type": "array"
        },
        "allowed_users": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Allowed Users",
          "type": "array"
        },
        "admin_users": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Admin Users",
          "type": "array"
        },
        "known_bot_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Known Bot Ids",
          "type": "array"
        },
        "full_mode_enabled": {
          "default": false,
          "title": "Full Mode Enabled",
          "type": "boolean"
        },
        "full_mode_verified": {
          "default": false,
          "title": "Full Mode Verified",
          "type": "boolean"
        },
        "proactive_verified": {
          "default": false,
          "title": "Proactive Verified",
          "type": "boolean"
        },
        "reply_window_seconds": {
          "default": 300,
          "maximum": 86400,
          "minimum": 1,
          "title": "Reply Window Seconds",
          "type": "integer"
        },
        "max_replies": {
          "default": 5,
          "maximum": 5,
          "minimum": 1,
          "title": "Max Replies",
          "type": "integer"
        },
        "signature_max_age_seconds": {
          "default": 300,
          "maximum": 86400,
          "minimum": 1,
          "title": "Signature Max Age Seconds",
          "type": "integer"
        },
        "api_base": {
          "default": "https://api.bot.qq.com",
          "title": "Api Base",
          "type": "string"
        },
        "token_url": {
          "default": "https://api.bot.qq.com/app/getAppAccessToken",
          "title": "Token Url",
          "type": "string"
        }
      },
      "required": [
        "instance_id",
        "kind",
        "bot_id",
        "secret_env"
      ],
      "title": "AdapterConfig",
      "type": "object"
    },
    "BlacklistedUser": {
      "additionalProperties": false,
      "properties": {
        "adapter_instance_id": {
          "minLength": 1,
          "title": "Adapter Instance Id",
          "type": "string"
        },
        "identity_namespace": {
          "minLength": 1,
          "title": "Identity Namespace",
          "type": "string"
        },
        "user_id": {
          "minLength": 1,
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "adapter_instance_id",
        "identity_namespace",
        "user_id"
      ],
      "title": "BlacklistedUser",
      "type": "object"
    },
    "ContextConfig": {
      "additionalProperties": false,
      "properties": {
        "max_request_bytes": {
          "default": 16777216,
          "maximum": 16777216,
          "minimum": 4096,
          "title": "Max Request Bytes",
          "type": "integer"
        },
        "max_tokens": {
          "anyOf": [
            {
              "maximum": 2000000,
              "minimum": 256,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "pi soft compaction threshold; null reserves 10% of the model window or output headroom, whichever is larger",
          "title": "Max Tokens"
        },
        "keep_recent_tokens": {
          "anyOf": [
            {
              "maximum": 2000000,
              "minimum": 128,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "pi recent context retained during compaction; null uses 20% of the model window",
          "title": "Keep Recent Tokens"
        },
        "compaction_output_tokens": {
          "default": 4096,
          "maximum": 32768,
          "minimum": 128,
          "title": "Compaction Output Tokens",
          "type": "integer"
        },
        "recent_messages": {
          "default": 64,
          "maximum": 100,
          "minimum": 1,
          "title": "Recent Messages",
          "type": "integer"
        },
        "topic_idle_seconds": {
          "default": 1800,
          "maximum": 86400,
          "minimum": 60,
          "title": "Topic Idle Seconds",
          "type": "integer"
        },
        "version": {
          "default": "context-v2",
          "title": "Version",
          "type": "string"
        }
      },
      "title": "ContextConfig",
      "type": "object"
    },
    "ExecutionConfig": {
      "additionalProperties": false,
      "properties": {
        "notify_before_tools": {
          "default": true,
          "title": "Notify Before Tools",
          "type": "boolean"
        },
        "max_active": {
          "default": 4,
          "description": "普通执行槽数；另有 1 个有界交互备用槽，正在运行及 UNKNOWN 槽不会因后台化释放。",
          "maximum": 32,
          "minimum": 1,
          "title": "Max Active",
          "type": "integer"
        },
        "sustained_limit": {
          "default": 2,
          "maximum": 31,
          "minimum": 1,
          "title": "Sustained Limit",
          "type": "integer"
        },
        "foreground_wait_ms": {
          "default": 5000,
          "maximum": 60000,
          "minimum": 0,
          "title": "Foreground Wait Ms",
          "type": "integer"
        },
        "interactive_budget": {
          "$ref": "#/$defs/RunBudget",
          "default": {
            "model_calls": 30,
            "tool_calls": 80,
            "active_seconds": 600,
            "total_wall_seconds": 3600,
            "output_tokens_per_call": 4096,
            "completion_reserve": 1
          }
        },
        "budget": {
          "$ref": "#/$defs/RunBudget",
          "default": {
            "model_calls": 60,
            "tool_calls": 200,
            "active_seconds": 1800,
            "total_wall_seconds": 7200,
            "output_tokens_per_call": 8192,
            "completion_reserve": 1
          }
        },
        "warm_max": {
          "default": 4,
          "maximum": 32,
          "minimum": 0,
          "title": "Warm Max",
          "type": "integer"
        },
        "warm_idle_max": {
          "default": 2,
          "maximum": 32,
          "minimum": 0,
          "title": "Warm Idle Max",
          "type": "integer"
        },
        "warm_ttl_seconds": {
          "default": 300,
          "maximum": 3600,
          "minimum": 1,
          "title": "Warm Ttl Seconds",
          "type": "integer"
        }
      },
      "title": "ExecutionConfig",
      "type": "object"
    },
    "ExpressionConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "expression_checked_only": {
          "default": false,
          "title": "Expression Checked Only",
          "type": "boolean"
        },
        "expression_self_reflect": {
          "default": true,
          "title": "Expression Self Reflect",
          "type": "boolean"
        },
        "learning_list": {
          "default": [
            {
              "conversation_id": "",
              "adapter_instance_id": "",
              "type": "group",
              "use": true,
              "learn": true
            }
          ],
          "items": {
            "$ref": "#/$defs/LearningRule"
          },
          "title": "Learning List",
          "type": "array"
        },
        "expression_groups": {
          "default": [],
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Expression Groups",
          "type": "array"
        },
        "learning_blacklist": {
          "default": [],
          "items": {
            "$ref": "#/$defs/BlacklistedUser"
          },
          "title": "Learning Blacklist",
          "type": "array"
        },
        "learner_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Learner Endpoint"
        },
        "learner_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Learner Model"
        },
        "learner_key_env": {
          "default": "QQBOT_EXPRESSION_KEY",
          "title": "Learner Key Env",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 300,
          "maximum": 1800,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "min_messages": {
          "default": 10,
          "maximum": 100,
          "minimum": 1,
          "title": "Min Messages",
          "type": "integer"
        },
        "max_messages": {
          "default": 40,
          "maximum": 100,
          "minimum": 10,
          "title": "Max Messages",
          "type": "integer"
        },
        "learn_interval_seconds": {
          "default": 300,
          "maximum": 86400,
          "minimum": 30,
          "title": "Learn Interval Seconds",
          "type": "integer"
        },
        "max_expression_learner": {
          "default": 3,
          "maximum": 8,
          "minimum": 1,
          "title": "Max Expression Learner",
          "type": "integer"
        }
      },
      "title": "ExpressionConfig",
      "type": "object"
    },
    "JudgeConfig": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "default": "rule",
          "enum": [
            "rule",
            "jev",
            "structured"
          ],
          "title": "Kind",
          "type": "string"
        },
        "endpoint": {
          "default": "https://api.typesafe.ai/v1/systemone",
          "title": "Endpoint",
          "type": "string"
        },
        "model": {
          "default": "jev-1.14.0",
          "title": "Model",
          "type": "string"
        },
        "api_key_env": {
          "default": "QQBOT_JUDGE_KEY",
          "title": "Api Key Env",
          "type": "string"
        },
        "thresholds": {
          "$ref": "#/$defs/SpeechThresholds",
          "default": {
            "invites_participation": 0.8,
            "continues_bot_topic": 0.85,
            "useful_contribution": 0.75,
            "private_exchange": 0.2,
            "wait_useful_contribution": 0.5
          }
        },
        "participation": {
          "$ref": "#/$defs/ParticipationSettings",
          "default": {
            "cooldown_seconds": 60,
            "min_human_messages": 3,
            "require_member_response": true,
            "max_recent_bot_ratio": 0.2,
            "max_rechecks": 2,
            "activity_window_seconds": 60,
            "activity_max_events": 20,
            "participation_budget_ratio": 0.2
          }
        }
      },
      "title": "JudgeConfig",
      "type": "object"
    },
    "LearningRule": {
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "default": "",
          "title": "Conversation Id",
          "type": "string"
        },
        "adapter_instance_id": {
          "default": "",
          "title": "Adapter Instance Id",
          "type": "string"
        },
        "type": {
          "default": "group",
          "enum": [
            "group",
            "private"
          ],
          "title": "Type",
          "type": "string"
        },
        "use": {
          "default": true,
          "title": "Use",
          "type": "boolean"
        },
        "learn": {
          "default": true,
          "title": "Learn",
          "type": "boolean"
        }
      },
      "title": "LearningRule",
      "type": "object"
    },
    "MemoryConfig": {
      "additionalProperties": false,
