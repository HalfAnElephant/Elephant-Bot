        "embedding_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding Model"
        },
        "embedding_version": {
          "default": "v1",
          "title": "Embedding Version",
          "type": "string"
        },
        "embedding_dimensions": {
          "anyOf": [
            {
              "maximum": 65536,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Embedding Dimensions"
        },
        "embedding_key_env": {
          "default": "QQBOT_EMBEDDING_KEY",
          "title": "Embedding Key Env",
          "type": "string"
        },
        "raw_retention_days": {
          "anyOf": [
            {
              "maximum": 3650,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "默认 null 永久保留原始记录；显式天数启用过期清理。",
          "title": "Raw Retention Days"
        }
      },
      "title": "MemoryConfig",
      "type": "object"
    },
    "ModelConfig": {
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
