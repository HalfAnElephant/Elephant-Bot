          "type": "boolean"
        },
        "auto_publish_self_reports": {
          "default": true,
          "title": "Auto Publish Self Reports",
          "type": "boolean"
        },
        "extractor_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extractor Endpoint"
        },
        "extractor_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extractor Model"
        },
        "extractor_key_env": {
          "default": "QQBOT_MEMORY_KEY",
          "title": "Extractor Key Env",
          "type": "string"
