[Unit]
Description=Elephant Leader and Workers
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qqbot
Group=qqbot-worker
SupplementaryGroups=qqbot systemd-journal
WorkingDirectory=/opt/qqbot
EnvironmentFile=/etc/qqbot/core.env
EnvironmentFile=/etc/qqbot/jobs.env
ExecStart=/opt/qqbot/.venv/bin/qqbot serve --config /etc/qqbot/core.yaml
ExecStopPost=+/usr/local/libexec/elephant-daemon-stopped
KillMode=control-group
TimeoutStopSec=30
Restart=on-failure
RestartSec=3
RuntimeDirectory=qqbot
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=true
ReadWritePaths=/var/lib/qqbot /run/qqbot /var/lib/qqbot-daemon-stops

[Install]
WantedBy=multi-user.target
